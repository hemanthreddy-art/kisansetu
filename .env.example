# KisanSetu - Environment Configuration
# SIH Problem Statement 26132 (Govt of Maharashtra)

# Application
NEXT_PUBLIC_APP_NAME="KisanSetu"
NEXT_PUBLIC_APP_TAGLINE="Right Market. Right Buyer. Right Price."
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="mr"

# Database (Prisma SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# API Mode (mock / live)
# Principles: Real data APIs can replace demo data later.
# Never pretend mock data is live government data.
NEXT_PUBLIC_DATA_MODE="demo"

# Secret Keys (Placeholders - never commit real secrets)
AUTH_SECRET="kisansetu-dev-secret-change-in-production"
